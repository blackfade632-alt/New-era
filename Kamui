        local n = {}
        for _, p in ipairs(P:GetPlayers()) do
            if p ~= LP then
                local tg = (p:GetAttribute("KamuiHubUser") == true) and " [HUB]" or ""
                table.insert(n, p.Name .. tg)
            end
        end
        if #n == 0 then table.insert(n, "Nenhum") end
        return n
    end
    local function getNN()
        local n = {}
        for _, p in ipairs(P:GetPlayers()) do if p ~= LP then table.insert(n, p.Name) end end
        if #n == 0 then table.insert(n, "Nenhum") end
        return n
    end
    local function cl(s) return (s:gsub(" %[HUB%]", "")) end
    local function getT() if not at then return nil end return P:FindFirstChild(cl(at)) end
    local function getMT() if not mt then return nil end return P:FindFirstChild(mt) end
