            local rp = RE:FindFirstChild("1Playe1rTrigge1rEven1t")
            if rp then
                pcall(function() rp:FireServer("Kick", t) end)
                pcall(function() rp:FireServer("KickPlayer", t) end)
            end
        end
        local hrp = t.Character and t.Character:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.CFrame = CFrame.new(0, -1000000, 0) end
        K.ok("Kick -> " .. t.Name)
    end})
    TT:AddButton({"Kill", function()
        local t = getT()
        if not t or not t.Character then K.err("Alvo invalido") return end
        local h = t.Character:FindFirstChildOfClass("Humanoid")
        if h then h.Health = 0 K.ok("Kill -> " .. t.Name) end
    end})
    TT:AddButton({"Crashar", function()
        local t = getT()
        if not t then K.err("Selecione um alvo") return end
        local o, e = K.reqHub(t)
        if not o then K.err(e) return end
        K.crashPlayer(t)
        K.err("Crash -> " .. t.Name)
    end})
    TT:AddSection({"Tag"})
