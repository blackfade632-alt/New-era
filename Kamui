TT:AddToggle({Name = "Executar Fling", Default = false, Callback = function(v)
    if not selectedFling then return end
    if selectedFling == "Fling Ball" then
        if selectedMethod == "Fast Fling" and selectedTargetName ~= "All" then K.err("Fast Fling so com All") return end
        fbA = v
        if v then
            task.spawn(function()
                local B = K.getBall()
                if not B then return end
                local bv = Instance.new("BodyVelocity")
                bv.Velocity = Vector3.new(9e8, 9e8, 9e8)
                bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                bv.Parent = B
                local si = (selectedMethod == "Fast Fling") and 1 or 2
                local ss = (selectedMethod == "Fast Fling") and 240 or 200
                local ci, ls, sa = 1, tick(), 0
                if fbC then fbC:Disconnect() end
                fbC = R.Heartbeat:Connect(function()
                    if not fbA then return end
                    K.protSelf()
                    local al = {}
                    for _, p in ipairs(P:GetPlayers()) do
                        if p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and not K.isP(p.Name) then
                            table.insert(al, p)
                        end
                    end
                    if #al == 0 then return end
                    local nw = tick()
                    if nw - ls >= si then
                        ci = ci + 1
                        if ci > #al then ci = 1 end
                        ls = nw
                        sa = 0
                    end
                    if ci > #al then ci = 1 end
                    local t = al[ci]
                    if t and t.Character and t.Character:FindFirstChild("HumanoidRootPart") then
                        sa = sa + math.rad(ss)
                        B.CFrame = t.Character.HumanoidRootPart.CFrame * CFrame.Angles(0, sa, 0)
                    end
                end)
            end)
        else
            if fbC then fbC:Disconnect() fbC = nil end
            K.protSelf() K.clearT()
        end
    elseif selectedFling == "Sofa" then
        if v then
            if selectedMethod ~= "nome" then return end
            cfA = true
            cfT = task.spawn(function()
                local pr = RS.RE and RS.RE:FindFirstChild("1Too1l")
                local cr = RS.RE and RS.RE:FindFirstChild("1Clea1rTool1s")
                if cr then pcall(function() cr:FireServer("ClearAllTools") end) end
                task.wait(0.3)
                if pr then pcall(function() pr:InvokeServer("PickingTools", "Couch") end) end
                task.wait(0.5)
                local ch = LP.Backpack:FindFirstChild("Couch") or LP.Character:FindFirstChild("Couch")
                if ch then pcall(function() ch.Parent = LP.Character end) end
                task.wait(0.3)
                pcall(function() VIM:SendKeyEvent(true, Enum.KeyCode.F, false, game) end)
                task.wait(0.5)
                local c = LP.Character
                if not c then return end
                local r = c:FindFirstChild("HumanoidRootPart")
                if not r then return end
                local sp, to = 0, 0
                local sd, fp = false, 0
                while cfA do
                    local cc = LP.Character
                    if not cc then cfA = false break end
                    local cr2 = cc:FindFirstChild("HumanoidRootPart")
                    if not cr2 then cfA = false break end
                    local t = selectedTargetName and selectedTargetName ~= "All" and P:FindFirstChild(selectedTargetName)
                    if t and t.Character then
                        local tr = t.Character:FindFirstChild("HumanoidRootPart")
                        local th = t.Character:FindFirstChildOfClass("Humanoid")
                        if tr and th then
                            sp = sp + math.rad(180)
                            to = to + 0.08
                            local yo = math.sin(to * 1.5) * 1.5 - 1.5
                            if not sd then
                                pcall(function() cr2.CFrame = tr.CFrame * CFrame.new(math.cos(sp) * 2, yo, math.sin(sp) * 2) * CFrame.Angles(math.rad(to * 300), sp, 0) end)
                                if th.Sit then sd = true fp = 0 end
                            else
                                if fp == 0 then
                                    pcall(function()
                                        local ex = tr:FindFirstChild("KamuiFlingVel")
                                        if ex then ex:Destroy() end
                                        local bv = Instance.new("BodyVelocity")
                                        bv.Name = "KamuiFlingVel"
                                        bv.Velocity = Vector3.new(10000, 500000, 10000)
                                        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                                        bv.Parent = tr
                                    end)
                                    fp = 1
                                end
                                pcall(function() cr2.CFrame = tr.CFrame * CFrame.new(math.cos(sp) * 2, yo, math.sin(sp) * 2) * CFrame.Angles(math.rad(to * 300), sp, 0) end)
                            end
                        end
                    end
                    task.wait()
                end
                if cr then pcall(function() cr:FireServer("ClearAllTools") end) end
            end)
        else
            cfA = false
            if cfT then pcall(function() task.cancel(cfT) end) cfT = nil end
            local c = LP.Character
            if c then
                local r = c:FindFirstChild("HumanoidRootPart")
                if r then
                    r.CFrame = CFrame.new(r.Position.X, 1500, r.Position.Z)
                    task.spawn(function()
                        local bv = Instance.new("BodyVelocity")
                        bv.Velocity = Vector3.new(0, 300, 0)
                        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                        bv.Parent = r
                        task.wait(2)
                        if bv and bv.Parent then bv:Destroy() end
                    end)
                    K.ok("Voce voou pro ceu!")
                end
            end
            task.wait(0.3)
            K.protSelf() K.clearT()
        end
    end
end})

