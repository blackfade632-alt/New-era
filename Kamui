    end})
    MT:AddButton({"Atualizar", function() pcall(function() md:Set(getNN()) end) end})
    MT:AddButton({"Me levar p/ backrooms", function()
        K.createBR()
        task.wait(0.5)
        K.tpBR(LP)
        K.ok("Voce foi p/ Backrooms")
    end})
    MT:AddButton({"Levar player p/ backrooms", function()
        local t = getMT()
        if not t then K.err("Selecione um player") return end
        K.createBR()
        task.wait(0.5)
        K.tpBR(t)
        K.ok(t.Name .. " -> Backrooms")
    end})
    MT:AddSection({"Meteoros"})
    MT:AddToggle({Name = "Chuva de Meteoros", Default = false, Callback = function(v)
        if v then
            local t = getMT()
            K.startMeteor(t)
            K.ok("Meteoros ON")
        else
            K.stopMeteor()
            K.err("Meteoros OFF")
        end
    end})
    MT:AddButton({"Lancar 1 Meteoro", function()
        local t = getMT()
        local pos
        if t and t.Character then
            local hrp = t.Character:FindFirstChild("HumanoidRootPart")
            if hrp then pos = hrp.Position end
        end
        if not pos then pos = Vector3.new(0, 0, 0) end
        K.spawnMeteor(pos)
        K.ok("Meteoro lancado")
    end})
    AW:SelectTab(TT)
end

